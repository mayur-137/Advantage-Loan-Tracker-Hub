rules_version = '2';

// Advantage Loan Tracker Hub: many users, many loans. Everything a tracker keeps lives under loans/<loanId>.
// Each loan has its own owner (loans/<id>.ownerUid) and its own sharing list (loans/<id>/access/<email>):
// approved people can view it; ones the owner made an admin can also change it. Nobody can see a loan
// they are not the owner of or approved for, except the app's administrator (isSuper), who can read
// every loan for support and change none (users are told so on the sign-in screen and in privacy.html).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email; }
    function loanPath(id) { return /databases/$(database)/documents/loans/$(id); }
    function accessPath(id) { return /databases/$(database)/documents/loans/$(id)/access/$(me()); }

    // The app's administrator: read-only access to every loan and user (never any write through this).
    function isSuper() {
      return signedIn() && me() == "mayursavaliya150@gmail.com";
    }
    function isOwner(id) {
      return signedIn() && exists(loanPath(id)) && get(loanPath(id)).data.ownerUid == request.auth.uid;
    }
    // Someone the owner approved (access/<their email>.status == "approved"), by invite or by request.
    function isViewer(id) {
      return signedIn() && exists(accessPath(id)) && get(accessPath(id)).data.status == "approved";
    }
    // An approved person the owner made an admin (role == "admin"). Only the owner can set or clear role.
    function isAdmin(id) {
      return isViewer(id) && get(accessPath(id)).data.get("role", "") == "admin";
    }
    // The owner signed in with Google within the last 5 minutes (needed to change the salary password).
    function freshLogin() {
      return request.auth.token.auth_time > (request.time.toMillis() / 1000) - 300;
    }
    function loanKeysOk() {
      return request.resource.data.keys().hasOnly(["ownerUid", "ownerEmail", "name", "bank", "createdAt", "updatedAt", "deleting"]);
    }
    // The owner has started deleting the loan (loans/<id>.deleting set, which needs a fresh Google sign-in). From then on
    // the owner may delete everything under it, settings and backups included, and finally the loan itself.
    function deleting(id) {
      return get(loanPath(id)).data.get("deleting", "") != "";
    }
    // Backups: one can be deleted only when it is an exact copy (same hash) of the newer backup named in
    // loans/<id>/backupsMeta/dedupe; its parts go first, so its head is still there to check.
    function dedupeOf(id, b) {
      let m = get(/databases/$(database)/documents/loans/$(id)/backupsMeta/dedupe).data;
      let mine = get(/databases/$(database)/documents/loans/$(id)/backups/$(b)).data.get("hash", "");
      return m.oldId == b && m.newId != b && mine != ""
        && get(/databases/$(database)/documents/loans/$(id)/backups/$(m.newId)).data.get("hash", "") == mine;
    }

    // ---- the loan itself: who owns it, its name and bank ----
    match /loans/{id} {
      // Readable by the owner and by approved people. Listing: your own loans (where ownerUid == my uid); the
      // administrator lists them all. (A query can't use the per-loan access check, so list has its own rule.)
      // (A loan that doesn't exist can be "read" as missing, so a deleted loan's link says "not found", not "ask for access".)
      allow get: if signedIn() && (resource == null || isSuper() || resource.data.ownerUid == request.auth.uid || isViewer(id));
      allow list: if signedIn() && (isSuper() || resource.data.ownerUid == request.auth.uid);
      // Anyone signed in can start a loan of their own, except the administrator (his account is for the dashboard only).
      allow create: if signedIn() && !isSuper()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == me()
        && loanKeysOk()
        && !("deleting" in request.resource.data);
      // The owner renames it; admins only bump updatedAt. Ownership never moves. Starting a delete (deleting set) needs a
      // fresh Google sign-in and can't be undone; a new loan can't be created already marked for deletion.
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && loanKeysOk()
        && (resource.data.get("deleting", "") == "" || request.resource.data.get("deleting", "") != "")
        && (request.resource.data.get("deleting", "") == "" || resource.data.get("deleting", "") != "" || freshLogin())
        && (resource.data.ownerUid == request.auth.uid
            || (isAdmin(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["updatedAt"])));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Tracker data. Approved viewers can read the shared collections only; salary (private/*),
      // backups and the access list are never readable by them. The owner and admins write; admins also read
      // private/*, but never touch backups or the access list, and cannot change the salary password
      // (private/lock, a salted hash): only the owner writes that, and only right after a fresh Google sign-in.
      match /{col}/{doc} {
        allow read: if isOwner(id) || isSuper()
          || (isAdmin(id) && !(col in ["backups", "access", "backupsMeta"]))
          || (isViewer(id) && col in ["loan", "balances", "rates", "prepay", "statements", "txns", "disb", "loantx"]);
        allow create, update: if !(col in ["backups", "access", "backupsMeta"])
          && ((isOwner(id) && (!(col == "private" && doc == "lock") || freshLogin()))
              || (isAdmin(id) && !(col == "private" && doc == "lock")));
        // The settings documents can be changed but never deleted from the app, except while the owner deletes the whole loan.
        allow delete: if (isOwner(id) && deleting(id)) || !(col in ["backups", "access", "backupsMeta"])
          && !(col == "loan" && doc == "settings")
          && !(col == "private" && (doc == "salary" || doc == "settingsMirror"))
          && ((isOwner(id) && (!(col == "private" && doc == "lock") || freshLogin()))
              || (isAdmin(id) && !(col == "private" && doc == "lock")));
      }

      // Sharing list. Anyone signed in can ask for themselves (pending only) and see their own entry.
      // Only the owner invites, approves, declines, removes, or makes someone an admin.
      match /access/{email} {
        allow read: if isOwner(id) || isSuper() || (signedIn() && me() == email);
        allow create: if isOwner(id) || (signedIn()
          && me() == email
          && request.resource.data.email == email
          && request.resource.data.status == "pending"
          && request.resource.data.keys().hasOnly(["email", "name", "status", "requestedAt"]));
        allow update, delete: if isOwner(id);
      }

      match /backups/{b} {
        allow read: if isOwner(id) || isSuper();
        allow create: if isOwner(id);
        allow delete: if isOwner(id) && (deleting(id) || dedupeOf(id, b));
      }
      match /backups/{b}/parts/{part} {
        allow read: if isOwner(id) || isSuper();
        allow create: if isOwner(id);
        allow delete: if isOwner(id) && (deleting(id) || dedupeOf(id, b));
      }
      match /backupsMeta/{doc} {
        allow read: if isOwner(id) || isSuper();
        allow write: if isOwner(id);
      }
    }

    // ---- "Shared with me": a pointer per loan, written by that loan's owner when they invite or approve someone ----
    match /inbox/{email}/loans/{id} {
      allow read: if (signedIn() && me() == email) || isOwner(id);
      allow create, update: if isOwner(id)
        && request.resource.data.keys().hasOnly(["name", "bank", "ownerEmail", "ownerName", "role", "sharedAt"]);
      allow delete: if (signedIn() && me() == email) || isOwner(id);
    }

    // ---- per-user settings (last opened loan, saved statement layouts) ----
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isSuper();
      allow write: if signedIn() && request.auth.uid == uid;
      match /{sub}/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
